{
  "name": "formtracker",
  "version": "1.4.0",
  "description": "FormTracker - import a mailing list, send email/paper form requests, and track who has responded",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test --test-force-exit \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.formtracker.app",
    "productName": "FormTracker",
    "files": [
      "main.js",
      "preload.js",
      "db/**/*",
      "lib/**/*",
      "renderer/**/*",
      "templates/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "FormTracker-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "FormTracker",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "electron-updater": "^6.8.9",
    "nodemailer": "^6.9.16",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "uuid": "^9.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
